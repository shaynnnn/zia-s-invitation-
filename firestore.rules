rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn()
        && request.auth.token.email in [
          "rosmarksurco@gmail.com",
          "aguilarshayn@gmail.com"
        ];
    }
    // Dec 3, 2026 11:59 PM Philippines time = Dec 3, 2026 16:00 UTC cutoff.
    function beforeRsvpDeadline() {
      return request.time < timestamp.value(2026, 12, 3, 16, 0, 0);
    }
    // Organizer setting overrides the automatic cutoff. If no setting exists,
    // RSVP availability follows the deadline.
    function rsvpOpen() {
      return exists(/databases/$(database)/documents/settings/rsvpControl)
        ? get(/databases/$(database)/documents/settings/rsvpControl).data.open == true
        : beforeRsvpDeadline();
    }
    function validPublicRsvp(data) {
      return signedIn()
        && data.ownerUid == request.auth.uid
        && data.source == "public"
        && data.guestName is string
        && data.guestName.size() > 0
        && data.contact is string
        && data.contact.size() > 0
        && data.attendance in ["yes", "no"]
        && data.seats is int
        && data.adults is int
        && data.kids is int
        && data.seats >= 0 && data.seats <= 2
        && data.adults >= 0 && data.kids >= 0
        && data.adults + data.kids == data.seats
        && (data.attendance == "no" ? data.seats == 0 : data.seats >= 1);
    }
    match /rsvps/{rsvpId} {
      allow create: if admin() || (rsvpOpen() && validPublicRsvp(request.resource.data));
      allow read: if admin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update: if admin() || (
        signedIn()
        && resource.data.ownerUid == request.auth.uid
        && rsvpOpen()
        && validPublicRsvp(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
      );
      allow delete: if admin();
    }
    match /wishes/{wishId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.guestName is string
        && request.resource.data.wish is string
        && request.resource.data.wish.size() <= 400;
      allow update, delete: if admin();
    }
    match /settings/{settingId} {
      allow read: if true;
      allow write: if admin();
    }
  }
}
